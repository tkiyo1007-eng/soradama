    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used to show the weather where you are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の天気を表示するために位置情報を使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to save today's sky to your photo library as wallpaper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の空を壁紙として写真に保存するために使用します。"
          }
        }
      }
